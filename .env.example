# Public Site Configuration
NEXT_PUBLIC_SITE_URL=https://eastfieldindia.com
NEXT_PUBLIC_CONTACT_EMAIL=

# Email Notification Provider (Resend REST API - recommended for serverless/200+ concurrent users)
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=inquiries@eastfieldindia.com

# Optional Webhook Forwarding (Slack / CRM / Make / Zapier / n8n)
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=

# Distributed Rate Limiting (Upstash Redis REST - enables stateless horizontal scaling)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_MAX_REQUESTS=8
RATE_LIMIT_WINDOW_SECONDS=900

# Optional Local / Persistent File Storage Path (defaults to .data/leads.ndjson)
INQUIRY_STORAGE_PATH=

# Authenticated Admin Lead Export API (/api/admin/leads - minimum 16 chars secret)
ADMIN_API_KEY=
