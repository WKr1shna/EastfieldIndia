# Public Site Configuration
NEXT_PUBLIC_SITE_URL=https://eastfieldindia.com
NEXT_PUBLIC_CONTACT_EMAIL=enquiries@eastfieldindia.com

# MongoDB Atlas Database (Primary Lead & Sample Request Storage)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/eastfield?retryWrites=true&w=majority
MONGODB_DB_NAME=eastfield

# Email Notification Provider (Resend REST API - recommended for serverless/200+ concurrent users)
RESEND_API_KEY=
INQUIRY_TO_EMAIL=enquiries@eastfieldindia.com
INQUIRY_FROM_EMAIL=enquiries@eastfieldindia.com

# Optional Webhook Forwarding (Slack / CRM / Make / Zapier / n8n)
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=

# Distributed Rate Limiting (Upstash Redis REST - enables stateless horizontal scaling)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_MAX_REQUESTS=8
RATE_LIMIT_WINDOW_SECONDS=900

# Optional Local / Persistent File Storage Path (defaults to .data/leads.ndjson)
INQUIRY_STORAGE_PATH=

# Authenticated Admin Lead Export & Management APIs (minimum 16 chars secrets)
ADMIN_API_KEY=
ADMIN_SESSION_SECRET=
